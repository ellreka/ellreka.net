{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["void/env", "vite/client"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "paths": {
      "void/routes": ["./.void/routes.d.ts"]
    }
  },
  "include": ["src"],
  "files": ["./.void/routes.d.ts", "./.void/env.d.ts"]
}
